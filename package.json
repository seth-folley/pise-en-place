{
  "name": "pise-en-place",
  "version": "1.0.0",
  "description": "Personal Pi extension package for safety, usage tracking, UI helpers, and workflow integrations.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "validate": "npm run typecheck && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seth-folley/pise-en-place.git"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/seth-folley/pise-en-place/issues"
  },
  "homepage": "https://github.com/seth-folley/pise-en-place#readme",
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.3",
    "@types/node": "^25.9.1",
    "typebox": "^1.1.38",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "pi": {
    "extensions": [
      "./extensions/evals/skill-eval/index.ts",
      "./extensions/safety/index.ts",
      "./extensions/usage/index.ts",
      "./extensions/skills/read-ledger.ts",
      "./extensions/skills/update-agent-skills.ts",
      "./extensions/ui/dracula-status-line.ts",
      "./extensions/ui/response-time.ts",
      "./extensions/ui/interactive-agent-questions.ts",
      "./extensions/orchestration/subagent/index.ts",
      "./extensions/productivity/context.ts",
      "./extensions/productivity/copy-session-id.ts",
      "./extensions/productivity/cut-input.ts",
      "./extensions/productivity/current-pr.ts",
      "./extensions/productivity/jira-worktree.ts",
      "./extensions/productivity/local-share.ts",
      "./extensions/productivity/markdown-output.ts",
      "./extensions/productivity/roadmap-writer.ts",
      "./extensions/productivity/todos.ts"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "files": [
    "extensions",
    "skills",
    "themes",
    "src",
    "docs",
    "README.md",
    "ROADMAP.md",
    "LICENSE"
  ],
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
